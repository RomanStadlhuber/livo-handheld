# Generates the build info header with the git state of the source tree.
# Run on every build via `cmake -P`, see the `mapping_build_info` target in CMakeLists.txt.
#
# Usage: cmake -DSOURCE_DIR=<source dir> -DOUTPUT=<header path> -P build_info.cmake
#
# The header is only rewritten if its content changes, so an unchanged git state does not trigger a recompile.
# Failing git calls never fail the build, the values fall back to "unknown" / -1.

set(MAPPING_COMMIT "unknown")
execute_process(
  COMMAND git -c safe.directory=* rev-parse HEAD
  WORKING_DIRECTORY "${SOURCE_DIR}"
  RESULT_VARIABLE _rev_result
  OUTPUT_VARIABLE _rev_output
  OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_QUIET
)
if(_rev_result EQUAL 0 AND _rev_output)
  set(MAPPING_COMMIT "${_rev_output}")
endif()

# exit code 0: clean, 1: uncommitted changes, anything else: unknown
set(MAPPING_DIRTY -1)
execute_process(
  COMMAND git -c safe.directory=* diff --quiet HEAD
  WORKING_DIRECTORY "${SOURCE_DIR}"
  RESULT_VARIABLE _diff_result
  OUTPUT_QUIET
  ERROR_QUIET
)
if(_diff_result STREQUAL "0")
  set(MAPPING_DIRTY 0)
elseif(_diff_result STREQUAL "1")
  set(MAPPING_DIRTY 1)
endif()

set(_content "// generated by cmake/build_info.cmake, do not edit
#pragma once
#define MAPPING_GIT_COMMIT \"${MAPPING_COMMIT}\"
#define MAPPING_GIT_DIRTY ${MAPPING_DIRTY}
")

set(_existing "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _existing)
endif()
if(NOT _existing STREQUAL _content)
  file(WRITE "${OUTPUT}" "${_content}")
endif()
